rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Izinkan akses baca dan tulis hanya untuk pengguna yang terautentikasi
      allow read, write: if request.auth != null;
    }
    
    // Aturan lebih spesifik untuk folder foto dan scan
    match /photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    match /scans/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
