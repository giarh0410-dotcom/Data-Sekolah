rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "smpialfakhir@gmail.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'nis', 'class']) &&
             data.name is string && data.name.size() > 0 &&
             data.nis is string && data.nis.size() > 0 &&
             data.class is string && data.class.size() > 0;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['name', 'code']) &&
             data.name is string && data.name.size() > 0 &&
             data.code is string && data.code.size() > 0;
    }

    function isValidExamSchedule(data) {
      return data.keys().hasAll(['subjectId', 'date', 'startTime']) &&
             isValidId(data.subjectId) &&
             data.date is string &&
             data.startTime is string &&
             (!('rombelName' in data) || data.rombelName is string);
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['subjectId', 'text', 'options', 'correctOption', 'class']) &&
             isValidId(data.subjectId) &&
             data.text is string &&
             data.options is list &&
             data.correctOption is int &&
             data.class is string;
    }

    function isValidExamRoom(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0;
    }

    function isValidCbtSession(data) {
      return data.keys().hasAll(['examScheduleId', 'subjectName', 'token']) &&
             isValidId(data.examScheduleId) &&
             data.subjectName is string &&
             data.token is string && data.token.size() == 6 &&
             (!('rombelName' in data) || data.rombelName is string);
    }

    function isValidExamResult(data) {
      return data.keys().hasAll(['sessionId', 'studentId', 'status']) &&
             isValidId(data.sessionId) &&
             isValidId(data.studentId) &&
             data.status in ['In Progress', 'Finished', 'completed', 'active'];
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['memberId', 'name', 'role', 'timestamp']) &&
             isValidId(data.memberId) &&
             data.name is string && data.name.size() > 0 &&
             data.role in ['student', 'teacher', 'staff'] &&
             data.timestamp is string && // date-time format
             (!('method' in data) || data.method in ['Face', 'Card', 'Manual']) &&
             (!('status' in data) || data.status in ['Hadir', 'Izin', 'Sakit', 'Alpa']) &&
             (!('waStatus' in data) || data.waStatus in ['Pending', 'Sent', 'Failed']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    incoming().uid == userId &&
                    (
                      (request.auth.token.email == "smpialfakhir@gmail.com" && incoming().role == "admin") ||
                      (request.auth.token.email != "smpialfakhir@gmail.com" && incoming().role == "viewer")
                    );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rombels/{rombelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, list: if isSignedIn();
      // Allow any signed in user to create an attendance record (e.g. at terminal)
      allow create: if isSignedIn() && isValidAttendance(incoming());
      // Allow updating notification status for any authenticated user (for terminal kiosk)
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['notified', 'waStatus', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /attendance-history/{attendanceId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidAttendance(incoming());
      allow update, delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidSubject(incoming());
      allow delete: if isAdmin();
    }

    match /examSchedules/{examScheduleId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidExamSchedule(incoming());
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidQuestion(incoming());
      allow delete: if isAdmin();
    }

    match /examRooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidExamRoom(incoming());
      allow delete: if isAdmin();
    }

    match /cbtSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidCbtSession(incoming());
      allow delete: if isAdmin();
    }

    match /examResults/{resultId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || (resource.data != null && resource.data.studentId == request.auth.uid));
      allow create: if isSignedIn() && isValidExamResult(incoming()) && (isAdmin() || incoming().studentId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || (request.auth.uid == resource.data.studentId && isValidExamResult(incoming())));
      allow delete: if isAdmin();
    }

    match /settings/secrets {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
